# --- Server ---
HOST=127.0.0.1
PORT=8787
# NODE_ENV=production makes the server refuse to start with development leftovers (see docs/DEPLOYMENT.md).
NODE_ENV=development

# --- Storage ---
# json: one file, fine for trying things out. postgres: required in production.
STORAGE=json
DATA_FILE=./data/appflowy-independent.json
# Required when STORAGE=postgres.
# DATABASE_URL=postgresql://tracker:change-me@127.0.0.1:5432/tracker
# Uploaded files (default: a files/ folder next to DATA_FILE). Back this up with the database.
# FILE_STORAGE_DIR=./data/files
# FILE_MAX_BYTES=104857600

# --- Secrets ---
# 64 hex characters (openssl rand -hex 32). Encrypts the AI provider keys; keep a copy outside the server.
# AI_KEY_SECRET=

# --- Accounts ---
# SIGNUP_ENABLED=false                      # nobody can register
# SIGNUP_ALLOWED_DOMAINS=yourcompany.com    # only these e-mail domains can register
# LOGIN_MAX_ATTEMPTS=10                     # failed sign-ins per account per window before a lockout
# LOGIN_WINDOW_SECONDS=900
# TRUST_PROXY=true                          # behind a reverse proxy you control (uses X-Forwarded-For)
# HSTS=true                                 # the site is served over HTTPS only

# --- E-mail (invitations, password reset codes, notification e-mails) ---
# Put real values in a private `.env` file (chmod 600) next to the server, or in the service environment.
# SMTP_HOST=smtp.example-mail.com
# SMTP_PORT=587                 # 587 = STARTTLS, 465 = TLS
# SMTP_USER=mailer@yourcompany.com
# SMTP_PASS=
# EMAIL_FROM=tracker@yourcompany.com
# EMAIL_FROM_NAME=Team Tracker
# BROADCAST_SMTP_HOST / _PORT / _USER / _PASS and BROADCAST_EMAIL_FROM work as aliases.
# PUBLIC_URL=https://tracker.example.com   # where links in e-mails point (else the page that made the request)
# EMAIL_NOTIFICATIONS=true                 # also e-mail mentions, replies and assignments (off by default)

# --- Document history ---
# A document version is saved automatically after a page has been quiet for this long, or edited for the max time.
# VERSION_QUIET_SECONDS=180
# CARD_HISTORY_QUIET_SECONDS=15
# CARD_HISTORY_MAX_SECONDS=60
# VERSION_MAX_SECONDS=600
# VERSION_KEEP_AUTO=100          # newest automatic versions kept per page (hand-saved versions are never removed)

# --- Web ---
# Origins allowed to call the API from a browser. Leave empty when the web app and API share one origin.
# CORS_ALLOWED_ORIGINS=https://tracker.example.com

# --- Logging ---
# API_LOG_FILE=./logs/api.log
# API_LOG_MAX_BYTES=20971520
# API_LOG_KEEP=5

# --- Development only (never set in production: the server refuses to start) ---
# Enables POST /api/workspaces/{id}/test-members for scripts and tests. There is no default key.
# DEV_TEST_KEY=choose-a-long-random-value
