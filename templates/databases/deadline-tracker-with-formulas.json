    {
      "id": "0FLHvN",
      "name": "Days left",
      "field_type": 19,
      "icon": "",
      "type_options": {
        "0": {},
        "19": {
          "format": 0,
          "expression": "if(prop(\"done\") or empty(prop(\"due\")), empty(), dateBetween(prop(\"due\"), today(), \"days\"))"
        }
      },
      "is_primary": false
    },
    {
      "id": "6YgYpT",
      "name": "Review on",
      "field_type": 19,
      "icon": "",
      "type_options": {
        "0": {},
        "19": {
          "expression": "if(empty(prop(\"due\")), empty(), dateSubtract(prop(\"due\"), 2, \"days\"))",
          "format": 0
        }
      },
      "is_primary": false
    },
    {
      "id": "sk1cPe",
      "name": "Health",
      "field_type": 19,
      "icon": "",
      "type_options": {
        "0": {},
        "19": {
          "expression": "ifs(prop(\"done\"), \"Complete\", empty(prop(\"due\")), \"No due date\", prop(\"due\") < today(), \"Overdue\", dateBetween(prop(\"due\"), today(), \"days\") == 0, \"Due today\", dateBetween(prop(\"due\"), today(), \"days\") <= 3, \"Due soon\", \"On track\")",
          "format": 0
        }
      },
      "is_primary": false
    }
