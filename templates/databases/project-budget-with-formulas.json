        "19": {
          "format": 0,
          "expression": "ifs((empty(prop(\"budget\")) or prop(\"budget\") <= 0), \"Set budget\", prop(\"spent\") > prop(\"budget\"), \"Over budget\", prop(\"spent\") >= prop(\"budget\") * 0.8, \"Watch\", \"On track\")"
        }
      },
      "is_primary": false
