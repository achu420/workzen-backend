        "19": {
          "format": 0,
          "expression": "if(prop(\"budget\") <= 0, \"Set budget\", if(prop(\"spent\") > prop(\"budget\"), \"Over budget\", if(prop(\"spent\") >= prop(\"budget\") * 0.8, \"Watch\", \"On track\")))"
