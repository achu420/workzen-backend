  "fields": [
    {
      "id": "total",
      "name": "Total tasks",
      "field_type": 19,
      "icon": "",
      "type_options": {
        "19": {
          "expression": "prop(\"tasks\").length()",
          "format": 0
        }
      },
      "is_primary": false
    },
    {
      "id": "completed",
      "name": "Completed",
      "field_type": 16,
      "icon": "",
      "type_options": {
        "16": {
          "calculation_type": 13,
          "condition_value": "[]",
          "target_field_id": "done",
          "relation_field_id": "tasks",
          "show_as": 0
        }
      },
      "is_primary": false
    },
    {
      "id": "completion",
      "name": "Completion %",
      "field_type": 19,
      "icon": "",
      "type_options": {
        "19": {
          "format": 36,
          "expression": "if(prop(\"total\") == 0, empty(), prop(\"completed\") / prop(\"total\"))"
        }
      },
      "is_primary": false
    },
    {
      "id": "health",
      "name": "Health",
      "field_type": 19,
      "icon": "",
      "type_options": {
        "19": {
          "format": 0,
          "expression": "if(prop(\"total\") == 0, \"Add tasks\", if(prop(\"completed\") == prop(\"total\"), \"Complete\", \"In progress\"))"
        }
      },
      "is_primary": false
    },
    {
      "id": "project",
      "name": "Project",
      "field_type": 0,
      "icon": "",
      "type_options": {
        "0": {}
      },
      "is_primary": true
    },
    {
      "id": "remaining",
      "name": "Remaining",
      "field_type": 19,
      "icon": "",
      "type_options": {
        "19": {
          "format": 0,
          "expression": "prop(\"total\") - prop(\"completed\")"
        }
      },
      "is_primary": false
    },
