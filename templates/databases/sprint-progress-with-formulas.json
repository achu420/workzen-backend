{
  "template_id": "sprint-progress-with-formulas",
  "order": 105,
  "name": "Sprint Progress with Formulas",
  "description": "Track sprint progress with completion percentages, visual progress bars, and blocker tags.",
  "icon": null,
  "category": "Project Management",
  "categories": [
    "Project Management",
    "Database",
    "Engineering"
  ],
  "author": "AppFlowy",
  "source_url": "https://appflowy.com/5fca8c8a-8126-428e-bb5e-0efeef22ab56/formula-sprint-progress",
  "database_id": "a4b6a745-2037-48a2-9879-7f8f3df5894b",
  "fields": [
    {
      "id": "SC0XdU",
      "name": "Progress bar",
      "field_type": 19,
      "icon": "",
      "type_options": {
        "0": {},
        "19": {
          "expression": "if((empty(prop(\"planned\")) or prop(\"planned\") <= 0), \"Set a target\", lets(p, prop(\"cWec1n\"), filled, floor(p * 10), repeat(\"■\", filled) + repeat(\"□\", 10 - filled) + \" \" + format(round(p * 100)) + \"%\"))",
          "format": 0
        }
      },
      "is_primary": false
    },
    {
      "id": "tags",
      "name": "Tags",
      "field_type": 4,
      "icon": "",
      "type_options": {
        "4": {
          "content": "{\"options\":[{\"id\":\"tags0\",\"name\":\"Backend\",\"color\":\"Blue\"},{\"id\":\"tags1\",\"name\":\"Design\",\"color\":\"Purple\"},{\"id\":\"tags2\",\"name\":\"Blocked\",\"color\":\"Orange\"},{\"id\":\"tags3\",\"name\":\"QA\",\"color\":\"Green\"}],\"disable_color\":false}"
        }
      },
      "is_primary": false
    },
    {
      "id": "completed",
      "name": "Completed",
      "field_type": 1,
      "icon": "",
      "type_options": {
        "1": {
          "format": 0
        }
      },
      "is_primary": false
    },
    {
      "id": "cWec1n",
      "name": "Progress",
      "field_type": 19,
      "icon": "",
      "type_options": {
        "0": {},
        "19": {
          "expression": "if((empty(prop(\"planned\")) or prop(\"planned\") <= 0), empty(), min(1, max(0, prop(\"completed\") / prop(\"planned\"))))",
          "format": 36
        }
      },
      "is_primary": false
    },
    {
      "id": "planned",
      "name": "Planned",
      "field_type": 1,
      "icon": "",
      "type_options": {
        "1": {
          "format": 0
        }
      },
      "is_primary": false
    },
    {
      "id": "task",
      "name": "Workstream",
      "field_type": 0,
      "icon": "",
      "type_options": {
        "0": {}
      },
      "is_primary": true
    },
    {
      "id": "bhtWlI",
      "name": "Focus",
      "field_type": 19,
      "icon": "",
      "type_options": {
        "0": {},
        "19": {
          "format": 0,
          "expression": "ifs(prop(\"tags\").includes(\"Blocked\"), \"Unblock first\", (empty(prop(\"planned\")) or prop(\"planned\") <= 0), \"Plan scope\", prop(\"completed\") >= prop(\"planned\"), \"Done\", \"Keep moving\")"
        }
      },
      "is_primary": false
    }
  ],
