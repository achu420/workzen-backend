          "external_id": "2eSFYu",
          "external_type": "text",
          "data": {
            "delta": [
              {
                "attributes": {
                  "bold": true
                },
                "insert": "Cut acronyms and jargon"
              },
              {
                "insert": ". Aim to explain to a child. E.g. do not assume that someone understands what MR means. Instead, write out \"merge request.\""
              }
            ]
          }
        },
