      "blocks": {
        "1aLOkR": {
          "id": "1aLOkR",
          "ty": "paragraph",
          "parent": "ea9fad93-56fa-554c-8dd2-6d7b8633cd09",
          "children": "WfPrNx",
          "external_id": "4Iy9Nz",
          "external_type": "text",
          "data": {
            "delta": []
          }
        },
        "CMBl6H": {
          "id": "CMBl6H",
          "ty": "bulleted_list",
          "parent": "ea9fad93-56fa-554c-8dd2-6d7b8633cd09",
          "children": "7DfQZ3",
          "external_id": "Wn1h_b",
          "external_type": "text",
          "data": {
            "delta": [
              {
                "insert": "Think about your storyline / structure first before getting into details. If we go through only headlines, is there any missing section that could undermine your conclusion or goal of writing this doc?"
              }
            ]
          }
        },
        "ERRW4D": {
          "id": "ERRW4D",
          "ty": "numbered_list",
          "parent": "ea9fad93-56fa-554c-8dd2-6d7b8633cd09",
          "children": "SyKlXN",
          "external_id": "jQztMe",
          "external_type": "text",
          "data": {
            "delta": [
              {
                "attributes": {
                  "bold": true
                },
                "insert": "Use short sentences"
              },
              {
                "insert": ". Ideally, sentences should have fewer than 15 words. This improves clarity. The "
              },
              {
                "attributes": {
                  "href": "https://hemingwayapp.com/"
                },
                "insert": "Hemingway Editor"
              },
              {
                "insert": " helps achieve this."
              }
            ]
          }
        },
        "lz9-Ci": {
          "id": "lz9-Ci",
          "ty": "paragraph",
          "parent": "ea9fad93-56fa-554c-8dd2-6d7b8633cd09",
          "children": "aoiNI0",
          "external_id": "slDUui",
          "external_type": "text",
          "data": {
            "delta": [
              {
                "attributes": {
                  "href": "https://www.workingbackwards.com/resources/correction-of-errors-coe"
                },
                "insert": "Correction of Errors"
              }
            ]
          }
        },
        "a0k0Gs": {
          "id": "a0k0Gs",
          "ty": "numbered_list",
          "parent": "ea9fad93-56fa-554c-8dd2-6d7b8633cd09",
          "children": "7fE5IV",
          "external_id": "N0Oqj2",
          "external_type": "text",
          "data": {
            "delta": [
              {
                "attributes": {
                  "bold": true
                },
                "insert": "Cut common phrases"
              },
              {
                "insert": ". E.g. replace \"due to the fact\" with \"because.\""
              }
            ]
          }
        },
        "VdhvJk": {
          "id": "VdhvJk",
          "ty": "bulleted_list",
          "parent": "ea9fad93-56fa-554c-8dd2-6d7b8633cd09",
          "children": "WXZFpW",
          "external_id": "io97Ss",
          "external_type": "text",
          "data": {
            "delta": [
              {
                "insert": "Assume others have low context - provide as much context as possible to avoid confusion."
              }
            ]
          }
        },
        "U0OM-5": {
          "id": "U0OM-5",
          "ty": "numbered_list",
          "parent": "ea9fad93-56fa-554c-8dd2-6d7b8633cd09",
          "children": "Xi06Tk",
          "external_id": "XulWF7",
          "external_type": "text",
          "data": {
            "delta": [
              {
                "attributes": {
                  "bold": true
                },
                "insert": "Use the \"So What?\" test"
              },
              {
                "insert": ". Before sending a communique, re-read and ask \"So, what?\" Does your content provide value? Will your audience understand? Are you sharing enough context?"
              }
            ]
          }
        },
        "Yr3y10": {
          "id": "Yr3y10",
          "ty": "numbered_list",
          "parent": "ea9fad93-56fa-554c-8dd2-6d7b8633cd09",
          "children": "ff56_s",
          "external_id": "-R0Deg",
          "external_type": "text",
          "data": {
            "delta": [
              {
                "attributes": {
                  "bold": true
                },
                "insert": "Be objective"
              },
              {
                "insert": ". Objectivity injects confidence. E.g. replace \"I think this change is working\" with \"our new approach led to a 5% increase.\""
              }
            ]
          }
        },
        "ZEukwG": {
          "id": "ZEukwG",
          "ty": "bulleted_list",
          "parent": "ea9fad93-56fa-554c-8dd2-6d7b8633cd09",
          "children": "1E1_34",
          "external_id": "POB05P",
          "external_type": "text",
          "data": {
            "delta": [
              {
                "insert": "Brainstorming in text forces you to clearly articulate proposals, designs, and ideas, with less variance in interpretations. This also breaks down silos by making information easily accessible. Documentation also helps with transparency and fosters collaboration."
              }
            ]
          }
        },
        "6zsZFU": {
          "id": "6zsZFU",
          "ty": "numbered_list",
          "parent": "ea9fad93-56fa-554c-8dd2-6d7b8633cd09",
          "children": "XQh5GG",
          "external_id": "m8wPrH",
          "external_type": "text",
          "data": {
            "delta": [
              {
                "attributes": {
                  "bold": true
                },
                "insert": "Use Subject-Verb-Object sentences"
              },
              {
                "insert": ". Follow this path when constructing sentences: Who/what are you writing about? ⮕ What did they do? ⮕ What was acted on?"
              }
            ]
          }
        },
        "lkTcr_": {
          "id": "lkTcr_",
          "ty": "heading",
          "parent": "ea9fad93-56fa-554c-8dd2-6d7b8633cd09",
          "children": "Rr9JGL",
          "external_id": "jjuwyr",
          "external_type": "text",
          "data": {
            "delta": [
              {
                "insert": "Resources"
              }
            ],
            "level": 2
          }
        },
        "QMRfXU": {
          "id": "QMRfXU",
          "ty": "bulleted_list",
          "parent": "ea9fad93-56fa-554c-8dd2-6d7b8633cd09",
          "children": "8Qo2Mf",
          "external_id": "Rs8aAC",
          "external_type": "text",
          "data": {
            "delta": [
              {
                "insert": "The secret sauce of writing a good doc is to think clearly and thoroughly about your subject."
              }
            ]
          }
        },
        "-LM5BQ": {
          "id": "-LM5BQ",
          "ty": "numbered_list",
          "parent": "ea9fad93-56fa-554c-8dd2-6d7b8633cd09",
          "children": "TSDsjy",
          "external_id": "bbqlK8",
          "external_type": "text",
          "data": {
            "delta": [
              {
                "attributes": {
                  "bold": true
                },
                "insert": "Replace adjectives with data"
              },
              {
                "insert": ". Hard figures trump descriptors like \"most\" or \"the majority.\""
              }
            ]
          }
        },
        "oEm3r1": {
          "id": "oEm3r1",
          "ty": "numbered_list",
          "parent": "ea9fad93-56fa-554c-8dd2-6d7b8633cd09",
          "children": "LDbhpb",
          "external_id": "zItkb6",
          "external_type": "text",
          "data": {
            "delta": [
              {
                "attributes": {
                  "bold": true
                },
                "insert": "Eliminate ambiguous words"
              },
              {
                "insert": ". Actively avoid words which weaken your point (e.g. \"nearly\" instead of an exact percentage)"
              }
            ]
          }
        },
        "bZPsxM": {
          "id": "bZPsxM",
          "ty": "bulleted_list",
          "parent": "ea9fad93-56fa-554c-8dd2-6d7b8633cd09",
          "children": "SOHXBW",
          "external_id": "78Nb1I",
          "external_type": "text",
          "data": {
            "delta": [
              {
                "insert": "Use indentations to organize the levels of information. In this way, your reader can easily zoom in / out."
              }
            ]
          }
        },
        "ULxGSh": {
          "id": "ULxGSh",
          "ty": "bulleted_list",
          "parent": "ea9fad93-56fa-554c-8dd2-6d7b8633cd09",
          "children": "_glXIu",
          "external_id": "0qt_pa",
          "external_type": "text",
          "data": {
            "delta": [
              {
                "insert": "\"Writing is nature's way of letting you know how sloppy your thinking is.\" -Dick Guindon, via Leslie Lamport"
              }
            ]
          }
        },
