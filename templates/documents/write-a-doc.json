        "cf2enj": {
          "id": "cf2enj",
          "ty": "bulleted_list",
          "parent": "ea9fad93-56fa-554c-8dd2-6d7b8633cd09",
          "children": "tl3gT9",
          "external_id": "Kfo1Ze",
          "external_type": "text",
          "data": {
            "delta": [
              {
                "insert": "Put a summary (TL;DR) at the very top including why the reader should care and what the doc is about."
              }
            ]
          }
        },
        "b_L1E8": {
          "id": "b_L1E8",
          "ty": "paragraph",
          "parent": "ea9fad93-56fa-554c-8dd2-6d7b8633cd09",
