        "LGO1Si": {
          "id": "LGO1Si",
          "ty": "quote",
          "parent": "ec2a7660-a8b0-5cf3-b35d-265db90f3eb8",
          "children": "BDfej4",
          "external_id": "hKGP85",
          "external_type": "text",
          "data": {
            "delta": [
              {
                "insert": "State the objectives of the project clearly and ensure they contain a measure of how to assess whether they have been achieved. \nThe statement should be realistic and should follow the SMART protocol: \n- Specific (get into the details), \n- Measurable (use quantitative language so that you know when you are finished)\n- Acceptable (to stakeholders)\n- Realistic (given project constraints)\n- Time-based (deadlines, not durations)"
              }
            ]
          }
        },
