        "text_map": {
          "zhoABR": "[{\"insert\":\"Week 1\"}]",
          "EKZ1-c": "[{\"insert\":\"Schedule introductions with Operations, Marketing, Project Management, and Finance teams\"}]",
          "er6pjC": "[{\"insert\":\"Familiarize yourself with the company's mission statement and core values\"}]",
          "s3KW9_": "[{\"insert\":\"Review the organizational chart to understand team roles and reporting lines\"}]",
          "MXTvGS": "[{\"insert\":\"Attend an orientation session on core services and project types\"}]",
          "AS9hRg": "[]",
          "kELyRv": "[{\"insert\":\"Week 2\"}]",
          "u52ZGQ": "[{\"insert\":\"Review the current sales pipeline\"}]",
          "aHHv2S": "[{\"insert\":\"Complete CRM tutorials and practice managing lead entries\"}]",
          "gx9ZWQ": "[{\"insert\":\"Review past proposals\"}]",
          "4HipLz": "[{\"insert\":\"Analyze recent sales reports to identify trends and areas for improvement\"}]",
          "-hxLGP": "[{\"insert\":\"Learn about key performance indicators (KPIs) used to measure success\"}]",
          "OXN65K": "[]",
          "bZ4EjI": "[{\"insert\":\"Week 3\"}]",
          "ETa7wq": "[{\"insert\":\"Attend training sessions on core services\"}]",
          "FmpWYG": "[{\"insert\":\"Schedule visits to ongoing projects with the project manager\"}]",
          "-m-vHV": "[{\"insert\":\"Analyze competitor products/services to understand market positioning\"}]",
          "ClA9kG": "[]",
          "Vi-XPP": "[{\"insert\":\"Week 4\"}]",
          "a71cN6": "[{\"insert\":\"Meet with the team lead to go over key client accounts\"}]",
          "2mOO2Q": "[{\"insert\":\"Review company templates and best practices for emails and calls\"}]",
          "KWM6B1": "[{\"insert\":\"Discuss sales targets and KPIs with the leadership team\"}]",
          "0um-Uo": "[{\"insert\":\"Work with management to identify and prioritize key accounts to focus on\"}]"
        }
