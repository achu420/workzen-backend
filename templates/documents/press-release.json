              "9nidFw": "[{\"insert\":\"Quotes & Getting Started:\",\"attributes\":{\"bold\":true,\"italic\":true}},{\"insert\":\" Add one quote from you or your company's spokesperson and a second quote from a hypothetical customer in which they describe the benefit they are getting from using your new product. Describe how easy it is to get started, and provide a link to your website where customers can get more information and get started.\"}]",
