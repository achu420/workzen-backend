              "hCdeGB": "[{\"insert\":\"Q: How do I get it?\"}]",
              "nhye8n": "[{\"insert\":\"Q: How does it work? (You are likely to have multiple versions of this question that cover different aspects of the customer experience.)\"}]",
              "WxrGlN": "[]",
              "UFEV_A": "[{\"insert\":\"Summary Paragraph: \",\"attributes\":{\"bold\":true,\"italic\":true}},{\"insert\":\"Start with the city, media outlet, and your proposed launch date. Give a summary of the product and the benefit.\"}]",
              "3Engie": "[{\"insert\":\"Q: How large is the estimated consumer demand for Melinda?  What is the TAM (total addressable market? \"}]",
              "gEpb-b": "[{\"insert\":\"The component parts to answering this include:\"}]",
