              "qhetA2": "[{\"insert\":\"Q: What/who are the current competitors for this product?\"}]",
              "tVuR7o": "[]",
              "oJtk1h": "[{\"insert\":\"For how many consumers is this problem big enough that they are willing to spend money to do something about it?\"}]",
              "eZzIUq": "[{\"insert\":\"Sample FAQs\"}]",
              "iyjfJE": "[]",
              "quujcD": "[]",
              "xuvMKs": "[{\"insert\":\"‍\"}]",
              "iB8EoT": "[{\"insert\":\"Q: Are there any potential regulatory or legal issues to consider?\"}]",
              "loiyeu": "[{\"insert\":\"Q: What are the per-unit economics of the product? That is, what is our expected Gross Profit and Contribution profit per unit?\"}]",
              "NbzT9D": "[]",
              "S4wHWA": "[{\"insert\":\"Q: What are the challenging product engineering problems we will need to solve?\"}]",
              "AdhRK3": "[{\"insert\":\"Subheading:\",\"attributes\":{\"italic\":true,\"bold\":true}},{\"insert\":\" Describe the customer for the product and what benefits they will gain from using it. One sentence only underneath the Heading.\"}]",
              "GxdnAa": "[]",
              "v-68bV": "[{\"insert\":\"If so, how much money would they be willing to spend?\"}]",
              "o4kMPC": "[{\"insert\":\"Problem Paragraph:\",\"attributes\":{\"bold\":true,\"italic\":true}},{\"insert\":\" This is where you describe the problem that your product is designed to solve. Make sure that you write this paragraph from the customer’s point of view. \"}]",
