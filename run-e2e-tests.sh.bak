#!/bin/bash  
# Run E2E Playwright tests with backend lifecycle management  
set -e  

BACKEND_DIR="/Volumes/work\ disk/Codes/Tracker/AppFlowy-Independent-Backend"
TEST_LOG="$BACKEND_DIR/test/test-output.log"
PORT=8787

cd "$BACKEND_DIR"

echo "=== E2E Test Suite for AppFlowy Independent Backend ==="
echo "Test log: $TEST_LOG"
echo ""

cleanup() {  
  echo ""
  echo "Cleaning up..."
  if [ -n "$SERVER_PID" ]; then  
    kill $SERVER_PID 2>/dev/null || true
    wait $SERVER_PID 2>/dev/null || true  
  fi
}  
trap cleanup EXIT  

# Clean previous test data  
rm -f ./data/appflowy-independent.json  
echo "Cleared previous test database."

# Start backend server on background  
echo "Starting backend server..."
PORT=$PORT node server.js > /tmp/backend-server.log 2>&1 &
SERVER_PID=$!
echo "Server PID: $SERVER_PID"

# Wait for server to be ready (check port availability)
for i in {1..30}; do  
  if nc -z localhost $PORT 2>/dev/null; then  
    echo "Backend is up on port $PORT"
    break  
  fi
  sleep 1  
done

# Verify it's actually serving  
if ! curl -s http://localhost:$PORT/health > /dev/null; then  
  echo "Server startup failed or health check unreachable"  
  cat /tmp/backend-server.log  
  exit 1  
fi  

echo ""
echo "Running Playwright tests..."
npx playwright test --reporter=line

exit_code=$?

echo ""
if [ $exit_code -eq 0 ]; then  
  echo "✅ All E2E tests passed!"
else  
  echo "❌ Tests failed with exit code $exit_code"  
fi  

cat /tmp/backend-server.log > "$TEST_LOG"