    "text_map": {
      "FemChs": "[{\"insert\":\"Celebrate once a client hits an early milestone. This could come in the form of an in-app notification, handwritten note, or a small treat delivered to their office.\"}]",
      "LG-J60": "[{\"insert\":\"Create an automated \"},{\"insert\":\"$\",\"attributes\":{\"mention\":{\"page_id\":\"800350e3-dd2d-44fd-b3aa-2159859efaff\",\"type\":\"page\"}}},{\"insert\":\"that triggers when a new user signs up.\"}]",
      "2Uy6Lf": "[{\"insert\":\"Build a greeting message for the initial login that includes a CTA to take their first action.\"}]",
      "B-1S92": "[{\"insert\":\" \"}]",
      "TjnL4n": "[{\"insert\":\"Design feature callouts that pop up when a user enters for the first time to help them navigate.\"}]",
      "bZjdV0": "[{\"insert\":\"Set Up Automation for All New Customers\",\"attributes\":{\"italic\":true}}]",
      "0pTXNd": "[{\"insert\":\"Create content for all of your empty states (the areas within your product that don’t have content or data in them until the user adds their own).\"}]",
      "u-jP_O": "[{\"insert\":\"Schedule the first meeting between your customer success team and the new customer.\"}]",
      "PbTCOt": "[{\"insert\":\"Prepare welcome packet for the new customer, filling in their specific Customer Success Team members, objectives, and due dates.\"}]",
      "MVOXHz": "[{\"insert\":\"Schedule a follow-up email to invite your new customer to login to the software that triggers after two days of inactivity.\"}]",
      "oER-5z": "[{\"insert\":\" \"}]",
      "WOP2Sl": "[{\"insert\":\"New Customer Onboarding Checklist\"}]",
      "wbZAg0": "[{\"insert\":\" \"}]",
      "CLnJDd": "[{\"insert\":\" \"}]",
      "QDKRFb": "[{\"insert\":\"Here, you’ll fill in the action items that your customer success team members or account managers will need to take in order to onboard a new customer. We’ve pre-populated a list of actions, but you’ll need to add, delete, or specify certain items depending upon your company’s product or service.\"}]",
      "1vMA_1": "[{\"insert\":\"Send over the welcome packet with the due date for the Customer Intake Questionnaire.\"}]",
      "io73KH": "[{\"insert\":\"Tasks to Do Individually for Each New Customer\",\"attributes\":{\"italic\":true}}]"
    }
  }
