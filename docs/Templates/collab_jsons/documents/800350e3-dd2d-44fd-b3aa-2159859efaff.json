      "M7RWEP": "[{\"insert\":\"Welcome to the \",\"attributes\":{\"italic\":false}},{\"insert\":\"[Insert Your Company Name] \",\"attributes\":{\"italic\":false,\"font_color\":\"0xff9e9e9e\"}},{\"insert\":\"customer community. We’re honored that you’ve chosen to work with us. It’s our utmost priority to ensure you have an excellent experience with our \",\"attributes\":{\"italic\":false}},{\"insert\":\"[product/service]\",\"attributes\":{\"italic\":false,\"font_color\":\"0xff9e9e9e\"}},{\"insert\":\" and team from day one, so we’ve compiled this packet of resources to provide a framework and clear\\npath for success in the first \",\"attributes\":{\"italic\":false}},{\"insert\":\"[Insert onboarding time frame]\",\"attributes\":{\"italic\":false,\"font_color\":\"0xff9e9e9e\"}},{\"insert\":\" and beyond.\",\"attributes\":{\"italic\":false}}]",
